<!-- Services > CARP VIP DHCP > keeper, as stored in config.xml (OPNsense/CarpVipDhcp). -->
<CarpVipDhcp version="1.4.1" description="CARP-VIP DHCP lease keeper">
  <keepers>
    <keeper>
      <enabled>1</enabled>
      <carpVip>203.0.113.102</carpVip>        <!-- the CARP VIP that carries the ISP-assigned address -->
      <chaddrOverride />                       <!-- empty = use the VIP's virtual MAC 00:00:5e:00:01:<vhid hex> -->
      <leasePolicy>follow</leasePolicy>        <!-- ISP hands out a new address (or prefix/router) -> rewrite VIP, gateway, reload filter -->
      <aliasName>wan1_carp_vip</aliasName>     <!-- firewall alias kept equal to the current public IP -->
      <arpNudgeInterval>120</arpNudgeInterval> <!-- refresh the ISP gateway's ARP entry while MASTER -->
      <arpListenPromisc>0</arpListenPromisc>
      <clientIdentifier>none</clientIdentifier> <!-- no option 61; "default" sends 01 + the virtual MAC -->
      <minLeaseTime>60</minLeaseTime>          <!-- ignore stop-gap leases shorter than this (cable modem) -->
      <vlanPriority />
      <requestOptions />
      <sendOptionsEncoded />
      <requestOptionsEncoded />
      <hostname />
      <defaultRouteMode>off</defaultRouteMode> <!-- must stay off: os-ha-helpers routing owns the default route -->
      <backupEgress>0</backupEgress>           <!-- must stay off: os-ha-helpers adds the backup egress routes -->
      <backupEgressForm>split</backupEgressForm>
      <backupEgressGateway />
      <backupEgressInterface />
      <backupEgressPrefixes />
      <description>WAN1 (DHCP from the ISP) public address on CARP vhid 221</description>
    </keeper>
  </keepers>
</CarpVipDhcp>
