<model>
    <mount>//OPNsense/HaHelpers</mount>
    <description>CARP failover helpers</description>
    <version>1.0.0</version>
    <items>
        <!-- general: the same on both nodes, carried by HA config sync -->
        <general>
            <enabled type="BooleanField">
                <Default>0</Default>
                <Required>Y</Required>
            </enabled>
            <vhid type=".\CarpVhidField">
                <BlankDesc>None (helpers inert)</BlankDesc>
                <ValidationMessage>Select a CARP virtual IP. Only CARP addresses configured under Interfaces: Virtual IPs can be used.</ValidationMessage>
            </vhid>
            <bootGrace type="IntegerField">
                <Default>120</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>3600</MaximumValue>
                <Required>Y</Required>
            </bootGrace>
            <masterOnlyServices type="CSVListField">
                <Mask>/^[a-z0-9_-]{1,64}$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>Service names may only contain lowercase letters, digits, dashes and underscores.</ValidationMessage>
            </masterOnlyServices>
            <serviceSettle type="IntegerField">
                <Default>1</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
            </serviceSettle>
            <backupEgress type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </backupEgress>
            <pinDefaultRoute type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </pinDefaultRoute>
            <unusableDefaultGws type="CSVListField">
                <Default>10.*,192.168.*,172.1[6-9].*,172.2[0-9].*,172.3[01].*,169.254.*</Default>
                <Required>Y</Required>
                <Mask>/^[0-9.*?\[\]-]{1,32}$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>Use address patterns made of digits, dots and the wildcards * ? [ ].</ValidationMessage>
            </unusableDefaultGws>
            <gwPingTimeout type="IntegerField">
                <Default>700</Default>
                <MinimumValue>100</MinimumValue>
                <MaximumValue>10000</MaximumValue>
                <Required>Y</Required>
            </gwPingTimeout>
            <peerPingTimeout type="IntegerField">
                <Default>500</Default>
                <MinimumValue>100</MinimumValue>
                <MaximumValue>10000</MaximumValue>
                <Required>Y</Required>
            </peerPingTimeout>
            <unboundRestart type="BooleanField">
                <Default>1</Default>
                <Required>Y</Required>
            </unboundRestart>
            <dnsCheckName type="HostnameField">
                <Default>opnsense.org</Default>
                <Required>Y</Required>
            </dnsCheckName>
            <dnsCheckServer type="NetworkField">
                <Default>127.0.0.1</Default>
                <NetMaskAllowed>N</NetMaskAllowed>
                <Required>Y</Required>
            </dnsCheckServer>
            <dnsRestartTries type="IntegerField">
                <Default>2</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>10</MaximumValue>
                <Required>Y</Required>
            </dnsRestartTries>
            <dnsSettle type="IntegerField">
                <Default>4</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
            </dnsSettle>
            <dnsRetryWait type="IntegerField">
                <Default>3</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
            </dnsRetryWait>
            <pfsyncMaxupd type="IntegerField">
                <Default>8</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>255</MaximumValue>
                <Required>Y</Required>
            </pfsyncMaxupd>
            <egressHookDelay type="IntegerField">
                <Default>2</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
            </egressHookDelay>
            <servicesHookDelay type="IntegerField">
                <Default>3</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>60</MaximumValue>
                <Required>Y</Required>
            </servicesHookDelay>
            <servicesBootDelay type="IntegerField">
                <Default>15</Default>
                <MinimumValue>0</MinimumValue>
                <MaximumValue>600</MaximumValue>
                <Required>Y</Required>
            </servicesBootDelay>
            <lockTimeout type="IntegerField">
                <Default>30</Default>
                <MinimumValue>1</MinimumValue>
                <MaximumValue>600</MaximumValue>
                <Required>Y</Required>
            </lockTimeout>
            <tailscaleNodes type="CSVListField">
                <Mask>/^[A-Za-z0-9._-]{1,63}$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>Tailscale host names may only contain letters, digits, dots, dashes and underscores.</ValidationMessage>
            </tailscaleNodes>
            <tailscaleHandoverHold type="IntegerField">
                <Default>45</Default>
                <MinimumValue>5</MinimumValue>
                <MaximumValue>600</MaximumValue>
                <Required>Y</Required>
            </tailscaleHandoverHold>
        </general>
        <!-- local: this node only, never part of HA config sync -->
        <local>
            <jumboMtuInterfaces type="CSVListField">
                <Mask>/^[a-z][a-z0-9_.]{0,30}$/</Mask>
                <MaskPerItem>Y</MaskPerItem>
                <ValidationMessage>Use device names such as vtnet1 or vtnet1_vlan12.</ValidationMessage>
            </jumboMtuInterfaces>
            <jumboMtu type="IntegerField">
                <Default>9000</Default>
                <MinimumValue>1280</MinimumValue>
                <MaximumValue>9216</MaximumValue>
                <Required>Y</Required>
            </jumboMtu>
        </local>
    </items>
</model>
